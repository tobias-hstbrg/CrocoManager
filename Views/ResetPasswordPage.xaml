<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CrocoManager.ViewModel"
             x:Class="CrocoManager.Views.ResetPasswordPage"
             Title="Passwort zurücksetzen"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid x:Name="MainGrid">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AdaptiveStates">
                <!-- Mobile Layout (width < 768) -->
                <VisualState x:Name="Mobile">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="ContentFlex" Property="FlexLayout.Padding" Value="20"/>
                        <Setter TargetName="ContentFlex" Property="FlexLayout.MaximumWidthRequest" Value="380"/>
                        <Setter TargetName="PageTitle" Property="Label.FontSize" Value="24"/>
                        <Setter TargetName="PageSubtitle" Property="Label.FontSize" Value="15"/>
                        <Setter TargetName="ResetCard" Property="Border.Padding" Value="24"/>
                        <Setter TargetName="EmailEntry" Property="Entry.FontSize" Value="15"/>
                        <Setter TargetName="EmailBorder" Property="Border.Padding" Value="14,0"/>
                        <Setter TargetName="EmailBorder" Property="Border.HeightRequest" Value="48"/>
                        <Setter TargetName="EmailBorder" Property="Border.Margin" Value="0,0,0,20"/>
                        <Setter TargetName="SubmitButton" Property="Button.HeightRequest" Value="48"/>
                        <Setter TargetName="SubmitButton" Property="Button.FontSize" Value="16"/>
                        <Setter TargetName="BackButton" Property="Button.FontSize" Value="14"/>
                    </VisualState.Setters>
                </VisualState>

                <!-- Desktop Layout (width >= 768) -->
                <VisualState x:Name="Desktop">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="768" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="ContentFlex" Property="FlexLayout.Padding" Value="40"/>
                        <Setter TargetName="ContentFlex" Property="FlexLayout.MaximumWidthRequest" Value="480"/>
                        <Setter TargetName="PageTitle" Property="Label.FontSize" Value="30"/>
                        <Setter TargetName="PageSubtitle" Property="Label.FontSize" Value="16"/>
                        <Setter TargetName="ResetCard" Property="Border.Padding" Value="40"/>
                        <Setter TargetName="EmailEntry" Property="Entry.FontSize" Value="16"/>
                        <Setter TargetName="EmailBorder" Property="Border.Padding" Value="16,0"/>
                        <Setter TargetName="EmailBorder" Property="Border.HeightRequest" Value="56"/>
                        <Setter TargetName="EmailBorder" Property="Border.Margin" Value="0,0,0,24"/>
                        <Setter TargetName="SubmitButton" Property="Button.HeightRequest" Value="56"/>
                        <Setter TargetName="SubmitButton" Property="Button.FontSize" Value="17"/>
                        <Setter TargetName="BackButton" Property="Button.FontSize" Value="15"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollView>
            <FlexLayout 
                x:Name="ContentFlex"
                Direction="Column"
                JustifyContent="Center"
                AlignItems="Center"
                Padding="20"
                MaximumWidthRequest="380">

                <VerticalStackLayout 
                    Spacing="8" 
                    Margin="0,0,0,30"
                    FlexLayout.AlignSelf="Stretch">
                    <Label 
                        x:Name="PageTitle"
                        Text="Passwort vergessen?"
                        FontAttributes="Bold"
                        FontSize="24"
                        TextColor="{StaticResource TextPrimary}"
                        HorizontalOptions="Center"/>
                    <Label 
                        x:Name="PageSubtitle"
                        Text="Gib deine E-Mail-Adresse ein, und setze dein neues Passwort."
                        FontSize="15"
                        TextColor="{StaticResource TextSecondary}"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <Border 
                    x:Name="ResetCard"
                    Style="{StaticResource SecondaryCard}"
                    Padding="24"
                    FlexLayout.AlignSelf="Stretch">

                    <VerticalStackLayout Spacing="16">

                        <Border
                            x:Name="EmailBorder"
                            Style="{StaticResource EntryBorder}"
                            Padding="14,0"
                            HeightRequest="48"
                            Margin="0,0,0,20">
                            <Entry 
                                x:Name="EmailEntry"
                                Placeholder="E-Mail" 
                                Text="{Binding Email}"
                                Keyboard="Email"
                                TextColor="{StaticResource TextPrimary}"
                                PlaceholderColor="{StaticResource PlaceholderText}"
                                BackgroundColor="Transparent"
                                FontSize="15"
                                VerticalOptions="Center"/>
                        </Border>

                        <Border
                        x:Name="PasswordBorder"
                        Style="{StaticResource EntryBorder}"
                        Padding="14,0"
                        HeightRequest="48"
                        Margin="0,0,0,5">
                        <Entry 
                            x:Name="PasswordEntry"
                            Placeholder="Passwort" 
                            IsPassword="True"
                            Text="{Binding Password}"
                            Keyboard="Text"
                            TextColor="{StaticResource TextPrimary}"
                            PlaceholderColor="{StaticResource PlaceholderText}"
                            BackgroundColor="Transparent"
                            FontSize="15"
                            VerticalOptions="Center"/>
                        </Border>

                        <Border
                         x:Name="PasswordCheckBorder"
                         Style="{StaticResource EntryBorder}"
                         Padding="14,0"
                         HeightRequest="48"
                         Margin="0,0,0,20">
                        <Entry 
                             x:Name="PasswordCheckEntry"
                             Placeholder="Passwort wiederholen" 
                             Text="{Binding PasswordCheck}"
                             Keyboard="Text"
                             IsPassword="True"
                             TextColor="{StaticResource TextPrimary}"
                             PlaceholderColor="{StaticResource PlaceholderText}"
                             BackgroundColor="Transparent"
                             FontSize="15"
                             VerticalOptions="Center"/>
                        </Border>

                        <Button 
                            x:Name="SubmitButton"
                            Text="Passwort ändern" 
                            Command="{Binding ResetPasswordCommand}"
                            Style="{StaticResource PrimaryButton}"
                            HeightRequest="48"
                            FontSize="16"/>

                    </VerticalStackLayout>
                </Border>
                
                <Button 
                    x:Name="BackButton"
                    Text="Zurück zum Login"
                    Command="{Binding GoToLoginCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"
                    BorderWidth="0"
                    FontSize="14"
                    Margin="0,24,0,0"
                    HorizontalOptions="Center"/>

            </FlexLayout>
        </ScrollView>
    </Grid>
</ContentPage>