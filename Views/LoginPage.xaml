<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CrocoManager.ViewModel"
             x:Class="CrocoManager.Views.LoginPage"
             Title="LoginPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid x:Name="MainGrid">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AdaptiveStates">
                <!-- Mobile Layout (width < 768) -->
                <VisualState x:Name="Mobile">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="ContentFlex" Property="FlexLayout.Padding" Value="20"/>
                        <Setter TargetName="ContentFlex" Property="FlexLayout.MaximumWidthRequest" Value="380"/>
                        <Setter TargetName="LogoSection" Property="VerticalStackLayout.Margin" Value="0,0,0,20"/>
                        <Setter TargetName="LogoEmoji" Property="Label.FontSize" Value="56"/>
                        <Setter TargetName="AppTitle" Property="Label.FontSize" Value="28"/>
                        <Setter TargetName="WelcomeText" Property="Label.FontSize" Value="16"/>
                        <Setter TargetName="LoginCard" Property="Border.Padding" Value="24"/>
                        <Setter TargetName="FormFlex" Property="FlexLayout.Margin" Value="0,16,0,0"/>
                        <Setter TargetName="EmailEntry" Property="Entry.FontSize" Value="15"/>
                        <Setter TargetName="PasswordEntry" Property="Entry.FontSize" Value="15"/>
                        <Setter TargetName="EmailBorder" Property="Border.Padding" Value="14,0"/>
                        <Setter TargetName="EmailBorder" Property="Border.HeightRequest" Value="48"/>
                        <Setter TargetName="EmailBorder" Property="Border.Margin" Value="0,0,0,16"/>
                        <Setter TargetName="PasswordBorder" Property="Border.Padding" Value="14,0"/>
                        <Setter TargetName="PasswordBorder" Property="Border.HeightRequest" Value="48"/>
                        <Setter TargetName="PasswordBorder" Property="Border.Margin" Value="0,0,0,16"/>
                        <Setter TargetName="LoginButton" Property="Button.HeightRequest" Value="48"/>
                        <Setter TargetName="LoginButton" Property="Button.FontSize" Value="16"/>
                        <Setter TargetName="LoginButton" Property="Button.Margin" Value="0,8,0,16"/>
                        <Setter TargetName="ForgotPasswordButton" Property="Button.FontSize" Value="13"/>
                        <Setter TargetName="ForgotPasswordButton" Property="Button.Margin" Value="0,0,0,20"/>
                        <Setter TargetName="RegisterSection" Property="VerticalStackLayout.Margin" Value="0,0,0,0"/>
                        <Setter TargetName="RegisterLabel" Property="Label.FontSize" Value="14"/>
                        <Setter TargetName="RegisterButton" Property="Button.HeightRequest" Value="48"/>
                        <Setter TargetName="RegisterButton" Property="Button.FontSize" Value="16"/>
                        <Setter TargetName="InfoButton" Property="ImageButton.WidthRequest" Value="40"/>
                        <Setter TargetName="InfoButton" Property="ImageButton.HeightRequest" Value="40"/>
                        <Setter TargetName="InfoButton" Property="ImageButton.Padding" Value="8"/>
                        <Setter TargetName="InfoButton" Property="ImageButton.Margin" Value="0,16,16,0"/>
                    </VisualState.Setters>
                </VisualState>

                <!-- Desktop Layout (width >= 768) -->
                <VisualState x:Name="Desktop">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="768" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="ContentFlex" Property="FlexLayout.Padding" Value="40"/>
                        <Setter TargetName="ContentFlex" Property="FlexLayout.MaximumWidthRequest" Value="520"/>
                        <Setter TargetName="LogoSection" Property="VerticalStackLayout.Margin" Value="0,0,0,30"/>
                        <Setter TargetName="LogoEmoji" Property="Label.FontSize" Value="72"/>
                        <Setter TargetName="AppTitle" Property="Label.FontSize" Value="36"/>
                        <Setter TargetName="WelcomeText" Property="Label.FontSize" Value="18"/>
                        <Setter TargetName="LoginCard" Property="Border.Padding" Value="40"/>
                        <Setter TargetName="FormFlex" Property="FlexLayout.Margin" Value="0,20,0,0"/>
                        <Setter TargetName="EmailEntry" Property="Entry.FontSize" Value="16"/>
                        <Setter TargetName="PasswordEntry" Property="Entry.FontSize" Value="16"/>
                        <Setter TargetName="EmailBorder" Property="Border.Padding" Value="16,0"/>
                        <Setter TargetName="EmailBorder" Property="Border.HeightRequest" Value="56"/>
                        <Setter TargetName="EmailBorder" Property="Border.Margin" Value="0,0,0,20"/>
                        <Setter TargetName="PasswordBorder" Property="Border.Padding" Value="16,0"/>
                        <Setter TargetName="PasswordBorder" Property="Border.HeightRequest" Value="56"/>
                        <Setter TargetName="PasswordBorder" Property="Border.Margin" Value="0,0,0,20"/>
                        <Setter TargetName="LoginButton" Property="Button.HeightRequest" Value="56"/>
                        <Setter TargetName="LoginButton" Property="Button.FontSize" Value="17"/>
                        <Setter TargetName="LoginButton" Property="Button.Margin" Value="0,8,0,20"/>
                        <Setter TargetName="ForgotPasswordButton" Property="Button.FontSize" Value="14"/>
                        <Setter TargetName="ForgotPasswordButton" Property="Button.Margin" Value="0,0,0,30"/>
                        <Setter TargetName="RegisterSection" Property="VerticalStackLayout.Margin" Value="0,0,0,0"/>
                        <Setter TargetName="RegisterLabel" Property="Label.FontSize" Value="15"/>
                        <Setter TargetName="RegisterButton" Property="Button.HeightRequest" Value="56"/>
                        <Setter TargetName="RegisterButton" Property="Button.FontSize" Value="17"/>
                        <Setter TargetName="InfoButton" Property="ImageButton.WidthRequest" Value="48"/>
                        <Setter TargetName="InfoButton" Property="ImageButton.HeightRequest" Value="48"/>
                        <Setter TargetName="InfoButton" Property="ImageButton.Padding" Value="10"/>
                        <Setter TargetName="InfoButton" Property="ImageButton.Margin" Value="0,24,24,0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Info Button in Top Right -->
        <Button 
            x:Name="InfoButton"
            ImageSource="info_icon.png"
            BackgroundColor="{StaticResource Primary}"
            BorderColor="Transparent"
            WidthRequest="20"
            HeightRequest="20"
            CornerRadius="8"
            Margin="0,16,16,0"
            HorizontalOptions="End"
            VerticalOptions="Start"
            Padding="4"
            ZIndex="1000"
            Command="{Binding TestConnectionCommand}">
        </Button>

        <ScrollView>
            <FlexLayout 
                x:Name="ContentFlex"
                Direction="Column"
                JustifyContent="Center"
                AlignItems="Center"
                Padding="20"
                MaximumWidthRequest="380"
                MinimumHeightRequest="600">

                <!-- Logo/Title Section -->
                <VerticalStackLayout 
                    x:Name="LogoSection"
                    Spacing="8" 
                    Margin="0,0,0,20"
                    FlexLayout.AlignSelf="Stretch">
                    <Label 
                        x:Name="LogoEmoji"
                        Text="🐊"
                        FontSize="56"
                        HorizontalOptions="Center"/>
                    <Label 
                        x:Name="AppTitle"
                        Text="CrocoManager"
                        FontAttributes="Bold"
                        FontSize="28"
                        TextColor="{StaticResource TextPrimary}"
                        HorizontalOptions="Center"/>
                    <Label 
                        x:Name="WelcomeText"
                        Text="Der Fütterungsmanager"
                        FontSize="16"
                        TextColor="{StaticResource TextSecondary}"
                        HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Login Form Card -->
                <Border 
                    x:Name="LoginCard"
                    BackgroundColor="{StaticResource CardBackground}"
                    StrokeThickness="0"
                    Padding="24"
                    StrokeShape="RoundRectangle 12"
                    FlexLayout.AlignSelf="Stretch">
                    <Border.Shadow>
                        <Shadow Brush="Black"
                                Opacity="0.1"
                                Radius="12"
                                Offset="0,4"/>
                    </Border.Shadow>

                    <FlexLayout 
                        x:Name="FormFlex"
                        Direction="Column"
                        Margin="0,16,0,0">

                        <!-- Username Field -->
                        <Border
                            x:Name="EmailBorder"
                            Stroke="{StaticResource BorderLight}"
                            StrokeThickness="1"
                            BackgroundColor="{StaticResource CardBackground}"
                            Padding="14,0"
                            HeightRequest="48"
                            Margin="0,0,0,16"
                            StrokeShape="RoundRectangle 8"
                            FlexLayout.AlignSelf="Stretch">
                            <Entry 
                                x:Name="EmailEntry"
                                Placeholder="E-Mail" 
                                Text="{Binding Email}"
                                Keyboard="Email"
                                FontSize="15"
                                VerticalOptions="Center"/>
                        </Border>

                        <!-- Password Field -->
                        <Border
                            x:Name="PasswordBorder"
                            Stroke="{StaticResource BorderLight}"
                            StrokeThickness="1"
                            BackgroundColor="{StaticResource CardBackground}"
                            Padding="14,0"
                            HeightRequest="48"
                            Margin="0,0,0,16"
                            StrokeShape="RoundRectangle 8"
                            FlexLayout.AlignSelf="Stretch">
                            <Entry 
                                x:Name="PasswordEntry"
                                Placeholder="Passwort" 
                                IsPassword="True" 
                                Text="{Binding Password}"
                                FontSize="15"
                                VerticalOptions="Center"/>
                        </Border>

                        <!-- Login Button -->
                        <Button 
                            x:Name="LoginButton"
                            Text="Anmelden" 
                            Command="{Binding LoginUserCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,8,0,16"
                            HeightRequest="48"
                            FontSize="16"
                            CornerRadius="8"
                            FlexLayout.AlignSelf="Stretch"/>

                        <!-- Forgot Password Button -->
                        <Button 
                            x:Name="ForgotPasswordButton"
                            Text="Passwort vergessen?"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Primary}"
                            FontSize="13"
                            Padding="0"
                            Margin="0,0,0,20"
                            HorizontalOptions="Center"
                            FlexLayout.AlignSelf="Center"/>

                        <!-- Register Section -->
                        <VerticalStackLayout 
                            x:Name="RegisterSection"
                            Spacing="12"
                            Margin="0,0,0,0"
                            FlexLayout.AlignSelf="Stretch">
                            <Label 
                                x:Name="RegisterLabel"
                                Text="Du hast noch keinen Account?"
                                FontSize="14"
                                TextColor="{StaticResource TextSecondary}"
                                HorizontalOptions="Center"/>
                            <Button 
                                x:Name="RegisterButton"
                                Text="Konto erstellen" 
                                Command="{Binding GoToRegisterCommand}"
                                Style="{StaticResource SecondaryButton}"
                                HeightRequest="48"
                                FontSize="16"
                                CornerRadius="8"/>
                        </VerticalStackLayout>

                    </FlexLayout>
                </Border>

            </FlexLayout>
        </ScrollView>
    </Grid>
</ContentPage>