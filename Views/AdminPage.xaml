<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CrocoManager.ViewModel"
             x:Class="CrocoManager.Views.AdminPage"
             Title="Admin Panel"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid x:Name="MainGrid">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AdaptiveStates">
                <!-- Mobile Layout (width < 768) -->
                <VisualState x:Name="Mobile">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="ContentScroll" Property="ScrollView.Padding" Value="16"/>
                        <Setter TargetName="ContentGrid" Property="Grid.MaximumWidthRequest" Value="600"/>
                        <Setter TargetName="PageTitle" Property="Label.FontSize" Value="24"/>
                        <Setter TargetName="PageSubtitle" Property="Label.FontSize" Value="14"/>
                        <Setter TargetName="AddUserCard" Property="Border.Padding" Value="16"/>
                        <Setter TargetName="AddUserTitle" Property="Label.FontSize" Value="16"/>
                        <Setter TargetName="EmailEntry" Property="Entry.FontSize" Value="15"/>
                        <Setter TargetName="EmailBorder" Property="Border.HeightRequest" Value="48"/>
                        <Setter TargetName="RolePicker" Property="Picker.FontSize" Value="15"/>
                        <Setter TargetName="RolePickerBorder" Property="Border.HeightRequest" Value="48"/>
                        <Setter TargetName="AddEmailButton" Property="Button.HeightRequest" Value="48"/>
                        <Setter TargetName="AddEmailButton" Property="Button.FontSize" Value="15"/>
                        <Setter TargetName="ExistingUsersTitle" Property="Label.FontSize" Value="16"/>
                        <Setter TargetName="LogoutButton" Property="Button.WidthRequest" Value="40"/>
                        <Setter TargetName="LogoutButton" Property="Button.HeightRequest" Value="40"/>
                        <Setter TargetName="LogoutButton" Property="Button.FontSize" Value="16"/>
                        <Setter TargetName="LogoutButton" Property="Button.Margin" Value="0,16,16,0"/>
                    </VisualState.Setters>
                </VisualState>

                <!-- Desktop Layout (width >= 768) -->
                <VisualState x:Name="Desktop">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="768" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="ContentScroll" Property="ScrollView.Padding" Value="40"/>
                        <Setter TargetName="ContentGrid" Property="Grid.MaximumWidthRequest" Value="1000"/>
                        <Setter TargetName="PageTitle" Property="Label.FontSize" Value="32"/>
                        <Setter TargetName="PageSubtitle" Property="Label.FontSize" Value="16"/>
                        <Setter TargetName="AddUserCard" Property="Border.Padding" Value="32"/>
                        <Setter TargetName="AddUserTitle" Property="Label.FontSize" Value="20"/>
                        <Setter TargetName="EmailEntry" Property="Entry.FontSize" Value="16"/>
                        <Setter TargetName="EmailBorder" Property="Border.HeightRequest" Value="56"/>
                        <Setter TargetName="RolePicker" Property="Picker.FontSize" Value="16"/>
                        <Setter TargetName="RolePickerBorder" Property="Border.HeightRequest" Value="56"/>
                        <Setter TargetName="AddEmailButton" Property="Button.HeightRequest" Value="56"/>
                        <Setter TargetName="AddEmailButton" Property="Button.FontSize" Value="16"/>
                        <Setter TargetName="ExistingUsersTitle" Property="Label.FontSize" Value="20"/>
                        <Setter TargetName="LogoutButton" Property="Button.WidthRequest" Value="48"/>
                        <Setter TargetName="LogoutButton" Property="Button.HeightRequest" Value="48"/>
                        <Setter TargetName="LogoutButton" Property="Button.FontSize" Value="18"/>
                        <Setter TargetName="LogoutButton" Property="Button.Margin" Value="0,24,24,0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Logout Button in Top Right -->
        <Button 
            x:Name="LogoutButton"
            Text="🚪"
            BackgroundColor="{StaticResource Primary}"
            TextColor="{StaticResource TextOnPrimary}"
            BorderColor="Transparent"
            WidthRequest="40"
            HeightRequest="40"
            CornerRadius="8"
            FontSize="16"
            Margin="0,16,16,0"
            HorizontalOptions="End"
            VerticalOptions="Start"
            Padding="8"
            ZIndex="1000"
            Command="{Binding SignOutCommand}"/>

        <ScrollView x:Name="ContentScroll" Padding="16">
            <Grid x:Name="ContentGrid" 
                  RowSpacing="20"
                  MaximumWidthRequest="600"
                  HorizontalOptions="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header Section -->
                <Grid Grid.Row="0" RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label 
                        x:Name="PageTitle"
                        Grid.Row="0"
                        Text="Manage User Access"
                        FontAttributes="Bold"
                        FontSize="24"
                        TextColor="{StaticResource TextPrimary}"/>
                    <Label 
                        x:Name="PageSubtitle"
                        Grid.Row="1"
                        Text="Add, update, or remove user permissions"
                        FontSize="14"
                        TextColor="{StaticResource TextSecondary}"/>
                </Grid>

                <!-- Add New User Card -->
                <Border 
                    x:Name="AddUserCard"
                    Grid.Row="1"
                    Style="{StaticResource SecondaryCard}"
                    Padding="16">

                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label 
                            x:Name="AddUserTitle"
                            Grid.Row="0"
                            Text="Add New User"
                            FontAttributes="Bold"
                            FontSize="16"
                            TextColor="{StaticResource TextPrimary}"/>

                        <!-- Email Field -->
                        <Border
                            x:Name="EmailBorder"
                            Grid.Row="1"
                            Style="{StaticResource EntryBorder}"
                            Padding="12,0"
                            HeightRequest="48">
                            <Entry 
                                x:Name="EmailEntry"
                                Placeholder="Enter email" 
                                Text="{Binding Email}"
                                Keyboard="Email"
                                TextColor="{StaticResource TextPrimary}"
                                PlaceholderColor="{StaticResource PlaceholderText}"
                                BackgroundColor="Transparent"
                                FontSize="15"
                                VerticalOptions="Center"/>
                        </Border>

                        <!-- Role Picker -->
                        <Border
                            x:Name="RolePickerBorder"
                            Grid.Row="2"
                            Style="{StaticResource EntryBorder}"
                            Padding="12,0"
                            HeightRequest="48">
                            <Picker 
                                x:Name="RolePicker"
                                Title="Select Role"
                                ItemsSource="{Binding Roles}"
                                SelectedItem="{Binding SelectedRole}"
                                TextColor="{StaticResource TextPrimary}"
                                BackgroundColor="Transparent"
                                FontSize="15"
                                VerticalOptions="Center"/>
                        </Border>

                        <!-- Add Button -->
                        <Button 
                            x:Name="AddEmailButton"
                            Grid.Row="3"
                            Text="Add Email" 
                            Command="{Binding AddEmailCommand}"
                            Style="{StaticResource PrimaryButton}"
                            HeightRequest="48"
                            FontSize="15"/>
                    </Grid>
                </Border>

                <!-- Existing Users Section -->
                <Label 
                    x:Name="ExistingUsersTitle"
                    Grid.Row="2"
                    Text="Existing Users"
                    FontAttributes="Bold"
                    FontSize="16"
                    TextColor="{StaticResource TextPrimary}"/>

                <!-- User List -->
                <CollectionView 
                    Grid.Row="3"
                    ItemsSource="{Binding WhitelistedEmails}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border 
                                Style="{StaticResource SecondaryCard}"
                                Padding="16"
                                Margin="0,0,0,12">

                                <Grid x:Name="UserItemGrid" RowSpacing="12" ColumnSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="ItemAdaptiveStates">
                                            <!-- Mobile Item Layout -->
                                            <VisualState x:Name="MobileItem">
                                                <VisualState.StateTriggers>
                                                    <AdaptiveTrigger MinWindowWidth="0" />
                                                </VisualState.StateTriggers>
                                                <VisualState.Setters>
                                                    <Setter TargetName="UserItemGrid" Property="Grid.ColumnDefinitions" Value="*"/>
                                                    <Setter TargetName="UserEmailLabel" Property="Grid.Row" Value="0"/>
                                                    <Setter TargetName="UserEmailLabel" Property="Grid.Column" Value="0"/>
                                                    <Setter TargetName="UserEmailLabel" Property="Grid.ColumnSpan" Value="1"/>
                                                    <Setter TargetName="UserRolePickerBorder" Property="Grid.Row" Value="1"/>
                                                    <Setter TargetName="UserRolePickerBorder" Property="Grid.Column" Value="0"/>
                                                    <Setter TargetName="UserRolePickerBorder" Property="Grid.ColumnSpan" Value="1"/>
                                                    <Setter TargetName="UpdateButton" Property="Grid.Row" Value="2"/>
                                                    <Setter TargetName="UpdateButton" Property="Grid.Column" Value="0"/>
                                                    <Setter TargetName="UpdateButton" Property="Grid.ColumnSpan" Value="1"/>
                                                    <Setter TargetName="DeleteButton" Property="Grid.Row" Value="2"/>
                                                    <Setter TargetName="DeleteButton" Property="Grid.Column" Value="1"/>
                                                    <Setter TargetName="DeleteButton" Property="Grid.ColumnSpan" Value="1"/>
                                                    <Setter TargetName="UserEmailLabel" Property="Label.FontSize" Value="14"/>
                                                    <Setter TargetName="UserRolePicker" Property="Picker.FontSize" Value="14"/>
                                                    <Setter TargetName="UserRolePickerBorder" Property="Border.HeightRequest" Value="44"/>
                                                    <Setter TargetName="UpdateButton" Property="Button.FontSize" Value="14"/>
                                                    <Setter TargetName="UpdateButton" Property="Button.HeightRequest" Value="44"/>
                                                    <Setter TargetName="DeleteButton" Property="Button.FontSize" Value="14"/>
                                                    <Setter TargetName="DeleteButton" Property="Button.HeightRequest" Value="44"/>
                                                </VisualState.Setters>
                                            </VisualState>

                                            <!-- Desktop Item Layout -->
                                            <VisualState x:Name="DesktopItem">
                                                <VisualState.StateTriggers>
                                                    <AdaptiveTrigger MinWindowWidth="768" />
                                                </VisualState.StateTriggers>
                                                <VisualState.Setters>
                                                    <Setter TargetName="UserItemGrid" Property="Grid.ColumnDefinitions" Value="2*,1.5*,Auto,Auto"/>
                                                    <Setter TargetName="UserEmailLabel" Property="Grid.Row" Value="0"/>
                                                    <Setter TargetName="UserEmailLabel" Property="Grid.Column" Value="0"/>
                                                    <Setter TargetName="UserEmailLabel" Property="Grid.ColumnSpan" Value="1"/>
                                                    <Setter TargetName="UserRolePickerBorder" Property="Grid.Row" Value="0"/>
                                                    <Setter TargetName="UserRolePickerBorder" Property="Grid.Column" Value="1"/>
                                                    <Setter TargetName="UserRolePickerBorder" Property="Grid.ColumnSpan" Value="1"/>
                                                    <Setter TargetName="UpdateButton" Property="Grid.Row" Value="0"/>
                                                    <Setter TargetName="UpdateButton" Property="Grid.Column" Value="2"/>
                                                    <Setter TargetName="UpdateButton" Property="Grid.ColumnSpan" Value="1"/>
                                                    <Setter TargetName="DeleteButton" Property="Grid.Row" Value="0"/>
                                                    <Setter TargetName="DeleteButton" Property="Grid.Column" Value="3"/>
                                                    <Setter TargetName="DeleteButton" Property="Grid.ColumnSpan" Value="1"/>
                                                    <Setter TargetName="UserEmailLabel" Property="Label.FontSize" Value="15"/>
                                                    <Setter TargetName="UserRolePicker" Property="Picker.FontSize" Value="15"/>
                                                    <Setter TargetName="UserRolePickerBorder" Property="Border.HeightRequest" Value="48"/>
                                                    <Setter TargetName="UpdateButton" Property="Button.FontSize" Value="15"/>
                                                    <Setter TargetName="UpdateButton" Property="Button.HeightRequest" Value="48"/>
                                                    <Setter TargetName="UpdateButton" Property="Button.WidthRequest" Value="100"/>
                                                    <Setter TargetName="DeleteButton" Property="Button.FontSize" Value="15"/>
                                                    <Setter TargetName="DeleteButton" Property="Button.HeightRequest" Value="48"/>
                                                    <Setter TargetName="DeleteButton" Property="Button.WidthRequest" Value="100"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>

                                    <!-- Email Label -->
                                    <Label 
                                        x:Name="UserEmailLabel"
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="{Binding Email}" 
                                        VerticalOptions="Center"
                                        LineBreakMode="WordWrap"
                                        TextColor="{StaticResource TextPrimary}"
                                        FontSize="14"/>

                                    <!-- Role Picker -->
                                    <Border
                                        x:Name="UserRolePickerBorder"
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Style="{StaticResource EntryBorder}"
                                        Padding="12,0"
                                        HeightRequest="44">
                                        <Picker 
                                            x:Name="UserRolePicker"
                                            Title="Select Role"
                                            ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.Roles}"
                                            SelectedItem="{Binding Role, Mode=TwoWay}"
                                            ItemDisplayBinding="{Binding .}"
                                            TextColor="{StaticResource TextPrimary}"
                                            BackgroundColor="Transparent"
                                            FontSize="14"
                                            VerticalOptions="Center"/>
                                    </Border>

                                    <!-- Update Button -->
                                    <Button 
                                        x:Name="UpdateButton"
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Text="Update"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}, Path=UpdateRoleCommand}"
                                        CommandParameter="{Binding .}"
                                        Style="{StaticResource PrimaryButton}"
                                        HeightRequest="44"
                                        FontSize="14"/>

                                    <!-- Delete Button -->
                                    <Button 
                                        x:Name="DeleteButton"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Text="Delete"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}, Path=DeleteEmailCommand}"
                                        CommandParameter="{Binding .}"
                                        Style="{StaticResource SecondaryButton}"
                                        HeightRequest="44"
                                        FontSize="14"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>