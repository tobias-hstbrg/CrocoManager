<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CrocoManager.Views.ObservationPage"
             Title=""
             BackgroundColor="{StaticResource PageBackground}">
    
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">


            <!-- Aktuelle Umweltdaten -->
            <Border BackgroundColor="#1BAA8A" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Aktuelle Umweltdaten (Everglades, FL)"
                    FontAttributes="Bold"
                    TextColor="White" />


                    <Grid ColumnDefinitions="*,*,*,*,*" RowDefinitions="Auto">
                        <Label Grid.Column="0" Text="Lufttemp.\n{Binding AirTemperature, StringFormat='{}{0} °C'}" TextColor="White" />
                        <Label Grid.Column="1" Text="Luftfeuchte\n{Binding Humidity, StringFormat='{}{0} %'}" TextColor="White" />
                        <Label Grid.Column="2" Text="Wassertemp.\n{Binding WaterTemperature, StringFormat='{}{0} °C'}" TextColor="White" />
                        <Label Grid.Column="3" Text="pH-Wert\n{Binding PhValue}" TextColor="White" />
                        <Label Grid.Column="4" Text="Salzgehalt\n{Binding Salinity, StringFormat='{}{0} ppt'}" TextColor="White" />
                    </Grid>
                </VerticalStackLayout>
            </Border>


            <!-- Neue Beobachtung -->
            <Border Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Neue Beobachtung dokumentieren"
                    FontAttributes="Bold"
                    FontSize="Medium" />    


                    <Picker Title="Tier auswählen"
                    ItemsSource="{Binding Animals}"
                    ItemDisplayBinding="{Binding Name}"
                    SelectedItem="{Binding SelectedAnimal}" />


                    <Picker Title="Tier Fütterung auswählen"
                    ItemsSource="{Binding Feedings}"
                    ItemDisplayBinding="{Binding DisplayName}"
                    SelectedItem="{Binding SelectedFeeding}" />


                    <Picker Title="Fressverhalten"
                    ItemsSource="{Binding FeedingBehaviors}"
                    SelectedItem="{Binding FeedingBehavior}" />


                    <Editor Placeholder="Beschreiben Sie besonderes Verhalten des Tieres..."
                    HeightRequest="100"
                    Text="{Binding Notes}" />


                    <HorizontalStackLayout Spacing="12">
                        <Button Text="Beobachtung speichern"
                        Command="{Binding SaveObservationCommand}"
                        BackgroundColor="#1BAA8A"
                        TextColor="White" />


                        <Button Text="Abbrechen"
                        Command="{Binding CancelCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>


        </VerticalStackLayout>
    </ScrollView>
</ContentPage>