<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:CrocoManager.ViewModel"
    xmlns:models="clr-namespace:CrocoManager.Models"
    x:Class="CrocoManager.Views.ObservationPage"
    x:DataType="viewmodels:ObservationViewModel"
    BackgroundColor="{StaticResource PageBackground}"
    Title="">
    
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header Section -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Label Grid.Column="0"
                       Text="Forschung"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"
                       VerticalOptions="Center"/>

                <Button Grid.Column="1"
                Text="🚪"
                BackgroundColor="{StaticResource Primary}"
                TextColor="{StaticResource TextOnPrimary}"
                BorderColor="Transparent"
                WidthRequest="50"
                HeightRequest="50"
                CornerRadius="8"
                FontSize="16"
                Padding="10"
                VerticalOptions="Center"
                Command="{Binding SignOutCommand}"/>    
            </Grid>

            <!-- Environmental Data Card -->
            <Border BackgroundColor="#16a085"
        Padding="20"
        Margin="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>

                <Grid RowDefinitions="Auto,Auto" RowSpacing="15">
                    <Label Grid.Row="0"
               Text="Aktuelle Umweltdaten (Everglades, FL)"
               FontSize="16"
               FontAttributes="Bold"
               TextColor="White"/>

                    <!-- Desktop: Horizontal Grid -->
                    <Grid Grid.Row="1" ColumnSpacing="10">
                        <Grid.IsVisible>
                            <OnIdiom x:TypeArguments="x:Boolean"
                         Phone="False"
                         Tablet="True"
                         Desktop="True"/>
                        </Grid.IsVisible>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Lufttemperatur -->
                        <Border Grid.Column="0"
                    BackgroundColor="White"
                    Padding="10"
                    HeightRequest="70">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="5">
                                <Label Grid.Row="0"
                           Text="Lufttemperatur"
                           FontSize="10"
                           TextColor="#16a085"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                                <Label Grid.Row="1"
                           Text="{Binding AirTemperature, StringFormat='{0:F1}°C'}"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Luftfeuchtigkeit -->
                        <Border Grid.Column="1"
                    BackgroundColor="White"
                    Padding="10"
                    HeightRequest="70">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="5">
                                <Label Grid.Row="0"
                           Text="Luftfeuchtigkeit"
                           FontSize="10"
                           TextColor="#16a085"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                                <Label Grid.Row="1"
                           Text="{Binding Humidity, StringFormat='{0:F0}%'}"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Wassertemperatur -->
                        <Border Grid.Column="2"
                    BackgroundColor="White"
                    Padding="10"
                    HeightRequest="70">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="5">
                                <Label Grid.Row="0"
                           Text="Wassertemperatur"
                           FontSize="10"
                           TextColor="#16a085"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                                <Label Grid.Row="1"
                           Text="{Binding WaterTemperature, StringFormat='{0:F1}°C'}"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- pH-Wert -->
                        <Border Grid.Column="3"
                    BackgroundColor="White"
                    Padding="10"
                    HeightRequest="70">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="5">
                                <Label Grid.Row="0"
                           Text="pH-Wert"
                           FontSize="10"
                           TextColor="#16a085"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                                <Label Grid.Row="1"
                           Text="{Binding PhValue, StringFormat='{0:F1}'}"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Salzgehalt -->
                        <Border Grid.Column="4"
                    BackgroundColor="White"
                    Padding="10"
                    HeightRequest="70">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="5">
                                <Label Grid.Row="0"
                           Text="Salzgehalt"
                           FontSize="10"
                           TextColor="#16a085"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                                <Label Grid.Row="1"
                           Text="{Binding Salinity, StringFormat='{0:F1} ppt'}"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Mobile: Vertical Grid -->
                    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                        <Grid.IsVisible>
                            <OnIdiom x:TypeArguments="x:Boolean"
                         Phone="True"
                         Tablet="False"
                         Desktop="False"/>
                        </Grid.IsVisible>

                        <!-- Lufttemperatur -->
                        <Border Grid.Row="0"
                    BackgroundColor="White"
                    Padding="15"
                    HeightRequest="60">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Label Grid.Column="0"
                           Text="Lufttemperatur"
                           FontSize="12"
                           TextColor="#16a085"
                           VerticalTextAlignment="Center"/>
                                <Label Grid.Column="1"
                           Text="{Binding AirTemperature, StringFormat='{0:F1}°C'}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           VerticalTextAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Luftfeuchtigkeit -->
                        <Border Grid.Row="1"
                    BackgroundColor="White"
                    Padding="15"
                    HeightRequest="60">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Label Grid.Column="0"
                           Text="Luftfeuchtigkeit"
                           FontSize="12"
                           TextColor="#16a085"
                           VerticalTextAlignment="Center"/>
                                <Label Grid.Column="1"
                           Text="{Binding Humidity, StringFormat='{0:F0}%'}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           VerticalTextAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Wassertemperatur -->
                        <Border Grid.Row="2"
                    BackgroundColor="White"
                    Padding="15"
                    HeightRequest="60">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Label Grid.Column="0"
                           Text="Wassertemperatur"
                           FontSize="12"
                           TextColor="#16a085"
                           VerticalTextAlignment="Center"/>
                                <Label Grid.Column="1"
                           Text="{Binding WaterTemperature, StringFormat='{0:F1}°C'}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           VerticalTextAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- pH-Wert -->
                        <Border Grid.Row="3"
                    BackgroundColor="White"
                    Padding="15"
                    HeightRequest="60">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Label Grid.Column="0"
                           Text="pH-Wert"
                           FontSize="12"
                           TextColor="#16a085"
                           VerticalTextAlignment="Center"/>
                                <Label Grid.Column="1"
                           Text="{Binding PhValue, StringFormat='{0:F1}'}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           VerticalTextAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Salzgehalt -->
                        <Border Grid.Row="4"
                    BackgroundColor="White"
                    Padding="15"
                    HeightRequest="60">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Label Grid.Column="0"
                           Text="Salzgehalt"
                           FontSize="12"
                           TextColor="#16a085"
                           VerticalTextAlignment="Center"/>
                                <Label Grid.Column="1"
                           Text="{Binding Salinity, StringFormat='{0:F1} ppt'}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           VerticalTextAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Observation Form Card -->
            <Border Style="{StaticResource SecondaryCard}"
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="20">
                    <Label Text="Neue Beobachtung dokumentieren"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"/>

                    <!-- Tier auswählen -->
                    <VerticalStackLayout Spacing="5">
                        <Label FontSize="14" TextColor="{StaticResource TextSecondary}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Tier auswählen "/>
                                    <Span Text="*" TextColor="Red"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Border Style="{StaticResource EntryBorder}"
                                Padding="12,0"
                                HeightRequest="48">
                            <Picker ItemsSource="{Binding Animals}"
                                    ItemDisplayBinding="{Binding PickerName}"
                                    SelectedItem="{Binding SelectedAnimal}"
                                    FontSize="16"
                                    TextColor="{StaticResource TextPrimary}"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Tier Fütterung auswählen -->
                    <VerticalStackLayout Spacing="5">
                        <Label FontSize="14" TextColor="{StaticResource TextSecondary}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Tier Fütterung auswählen "/>
                                    <Span Text="*" TextColor="Red"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Border Style="{StaticResource EntryBorder}"
                                Padding="12,0"
                                HeightRequest="48">
                            <Picker ItemsSource="{Binding Feedings}"
                                    SelectedItem="{Binding SelectedFeeding}"
                                    ItemDisplayBinding="{Binding DisplayName}"
                                    FontSize="16"
                                    TextColor="{StaticResource TextPrimary}"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Fressverhalten -->
                    <VerticalStackLayout Spacing="5">
                        <Label FontSize="14" TextColor="{StaticResource TextSecondary}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Fressverhalten "/>
                                    <Span Text="*" TextColor="Red"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Border Style="{StaticResource EntryBorder}"
                                Padding="12,0"
                                HeightRequest="48">
                            <Picker ItemsSource="{Binding FeedingBehaviors}"
                                    SelectedItem="{Binding FeedingBehavior}"
                                    FontSize="16"
                                    TextColor="{StaticResource TextPrimary}"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Beobachtungen / Notizen -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Beobachtungen / Notizen"
                               FontSize="14"
                               TextColor="{StaticResource TextSecondary}"/>
                        <Border Style="{StaticResource EntryBorder}"
                                Padding="12"
                                HeightRequest="120">
                            <Editor Text="{Binding Notes}"
                                    Placeholder="Beschreiben Sie besonderes Verhalten des Tieres..."
                                    FontSize="16"
                                    TextColor="{StaticResource TextPrimary}"
                                    PlaceholderColor="{StaticResource PlaceholderText}"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Fill"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="15" Margin="0,10,0,0">
                        <Button Grid.Column="0"
                                Text="Beobachtung speichern"
                                BackgroundColor="#16a085"
                                TextColor="White"
                                HeightRequest="50"
                                CornerRadius="8"
                                FontSize="16"
                                FontAttributes="Bold"
                                Command="{Binding SaveObservationCommand}"/>

                        <Button Grid.Column="1"
                                Text="Abbrechen"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource TextSecondary}"
                                BorderColor="{StaticResource BorderColor}"
                                BorderWidth="1"
                                HeightRequest="50"
                                CornerRadius="8"
                                FontSize="16"
                                Command="{Binding CancelCommand}"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Recent Observations Section (Optional) -->
            <Label Text="Letzte Beobachtungen"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   Margin="0,10,0,0"/>

            <CollectionView ItemsSource="{Binding RecentObservations}"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="15"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Observation">
                        <Border Style="{StaticResource SecondaryCard}"
                    Padding="15">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>

                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                                <!-- Title: Animal Name -->
                                <Label Grid.Row="0"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Animal.Name}"/>
                                            <Span Text=" - "/>
                                            <Span Text="{Binding Animal.Species}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <!-- Subtitle: Feeding info -->
                                <Label Grid.Row="1"
                               FontSize="12"
                               TextColor="{StaticResource TextSecondary}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Fütterung: "/>
                                            <Span Text="{Binding Feeding.FeedingDate, StringFormat='{0:dd.MM.yyyy}'}"/>
                                            <Span Text=" - "/>
                                            <Span Text="{Binding Feeding.FeedingPlan.Name}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <!-- Environmental Data Row -->
                                <Label Grid.Row="2"
                               FontSize="12"
                               TextColor="{StaticResource TextSecondary}"
                               IsVisible="{Binding HasEnvironmentalData}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="☀️ Luft: " FontAttributes="Bold"/>
                                            <Span Text="{Binding EnvironmentalData.AirTemperatureCelsius, StringFormat='{0:F1}°C'}"/>
                                            <Span Text=", "/>
                                            <Span Text="{Binding EnvironmentalData.HumidityPercent, StringFormat='{0:F0}%'}"/>
                                            <Span Text="   💧 Wasser: " FontAttributes="Bold"/>
                                            <Span Text="{Binding EnvironmentalData.WaterTemperatureCelsius, StringFormat='{0:F1}°C'}"/>
                                            <Span Text=", pH "/>
                                            <Span Text="{Binding EnvironmentalData.PhValue, StringFormat='{0:F1}'}"/>
                                            <Span Text=", "/>
                                            <Span Text="{Binding EnvironmentalData.SalinityPpt, StringFormat='{0:F1} ppt'}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <!-- Behavior and Notes -->
                                <Grid Grid.Row="3" RowDefinitions="Auto,Auto" RowSpacing="5">
                                    <Label Grid.Row="0"
                               FontSize="13"
                               TextColor="{StaticResource TextPrimary}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Verhalten: " FontAttributes="Bold"/>
                                                <Span Text="{Binding FeedingBehavior}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <Label Grid.Row="1"
                               Text="{Binding Notes}"
                               FontSize="12"
                               TextColor="{StaticResource TextSecondary}"
                               LineBreakMode="WordWrap"
                               MaxLines="3"
                               IsVisible="{Binding HasNotes}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>