<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:CrocoManager.ViewModel"
    xmlns:models="clr-namespace:CrocoManager.Models"
    x:Class="CrocoManager.Views.FeedingPage"
    x:DataType="viewmodels:FeedingViewModel"
    BackgroundColor="{StaticResource PageBackground}"
    Title="">

    <VerticalStackLayout Padding="24" Spacing="16">
        <!-- Header Section -->
        <Grid Grid.Row="0" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <!-- Row 0: Label + SignOut button (aligned with end of row 1 button) -->
            <Label Grid.Row="0" Grid.Column="0"
           Text="Fütterung"
           FontSize="28"
           FontAttributes="Bold"
           TextColor="{StaticResource TextPrimary}"
           VerticalOptions="Center"/>

            <Button Grid.Row="0" Grid.Column="1"
            Text="🚪"
            BackgroundColor="{StaticResource Primary}"
            TextColor="{StaticResource TextOnPrimary}"
            BorderColor="Transparent"
            WidthRequest="50"
            HeightRequest="50"
            CornerRadius="8"
            FontSize="16"
            Padding="10"
            VerticalOptions="Start"
            HorizontalOptions="End"
            Margin="0,0,0,0"
            Command="{Binding SignOutCommand}"/>
        </Grid>

        <!-- Heutige Fütterung -->
        <Frame BackgroundColor="#16a085" CornerRadius="12">
            <VerticalStackLayout>
                <Label Text="Heutige Fütterung"
                       FontSize="18"
                       TextColor="White" />

                <Label Text="{Binding CurrentFeeding.FeedingDate}"
                       TextColor="White" />

                <Label Text="{Binding CurrentFeeding.FeedingPlan.Name}"
                       TextColor="White" />

                <Label Text="{Binding CurrentFeeding.FeedingPlan.FoodType}"
                       TextColor="White" />
            </VerticalStackLayout>
        </Frame>

        <!-- Tiere -->
        <CollectionView ItemsSource="{Binding Animals}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:FeedingAnimalStatus">
                    <HorizontalStackLayout Spacing="12">
                        <CheckBox IsChecked="{Binding WasFed}" />
                        <Label Text="{Binding Animal.Name}" />
                    </HorizontalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Buttons -->
        <Button
            Text="Fütterung abschließen"
            Command="{Binding SaveCommand}" />

        <Button
            Text="Abbrechen"
            Command="{Binding SignOutCommand}" />

    </VerticalStackLayout>
</ContentPage>