<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CrocoManager.Views.HomePage"
             Title="Dashboard"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid x:Name="MainGrid" Padding="20">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AdaptiveStates">
                <!-- Mobile Layout (width < 768) -->
                <VisualState x:Name="Mobile">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="HeaderStack" Property="StackLayout.Orientation" Value="Horizontal"/>
                        <Setter TargetName="HeaderStack" Property="StackLayout.Spacing" Value="10"/>
                        <Setter TargetName="DashboardTitle" Property="Label.FontSize" Value="28"/>
                        <Setter TargetName="AddButton" Property="Button.WidthRequest" Value="50"/>
                        <Setter TargetName="AddButton" Property="Button.HeightRequest" Value="50"/>
                        <Setter TargetName="StatsGrid" Property="Grid.ColumnDefinitions" Value="*"/>
                        <Setter TargetName="StatsGrid" Property="Grid.RowDefinitions" Value="Auto,Auto,Auto"/>
                        <Setter TargetName="Card1" Property="Grid.Column" Value="0"/>
                        <Setter TargetName="Card1" Property="Grid.Row" Value="0"/>
                        <Setter TargetName="Card2" Property="Grid.Column" Value="0"/>
                        <Setter TargetName="Card2" Property="Grid.Row" Value="1"/>
                        <Setter TargetName="Card3" Property="Grid.Column" Value="0"/>
                        <Setter TargetName="Card3" Property="Grid.Row" Value="2"/>
                        <Setter TargetName="InfoGrid" Property="Grid.ColumnDefinitions" Value="*"/>
                        <Setter TargetName="InfoGrid" Property="Grid.RowDefinitions" Value="Auto,Auto"/>
                        <Setter TargetName="InfoCard1" Property="Grid.Column" Value="0"/>
                        <Setter TargetName="InfoCard1" Property="Grid.Row" Value="0"/>
                        <Setter TargetName="InfoCard2" Property="Grid.Column" Value="0"/>
                        <Setter TargetName="InfoCard2" Property="Grid.Row" Value="1"/>
                    </VisualState.Setters>
                </VisualState>

                <!-- Desktop Layout (width >= 768) -->
                <VisualState x:Name="Desktop">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="768" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="HeaderStack" Property="StackLayout.Orientation" Value="Horizontal"/>
                        <Setter TargetName="HeaderStack" Property="StackLayout.Spacing" Value="20"/>
                        <Setter TargetName="DashboardTitle" Property="Label.FontSize" Value="32"/>
                        <Setter TargetName="AddButton" Property="Button.WidthRequest" Value="60"/>
                        <Setter TargetName="AddButton" Property="Button.HeightRequest" Value="60"/>
                        <Setter TargetName="StatsGrid" Property="Grid.ColumnDefinitions" Value="*,*,*"/>
                        <Setter TargetName="StatsGrid" Property="Grid.RowDefinitions" Value="Auto"/>
                        <Setter TargetName="Card1" Property="Grid.Column" Value="0"/>
                        <Setter TargetName="Card1" Property="Grid.Row" Value="0"/>
                        <Setter TargetName="Card2" Property="Grid.Column" Value="1"/>
                        <Setter TargetName="Card2" Property="Grid.Row" Value="0"/>
                        <Setter TargetName="Card3" Property="Grid.Column" Value="2"/>
                        <Setter TargetName="Card3" Property="Grid.Row" Value="0"/>
                        <Setter TargetName="InfoGrid" Property="Grid.ColumnDefinitions" Value="*,*"/>
                        <Setter TargetName="InfoGrid" Property="Grid.RowDefinitions" Value="Auto"/>
                        <Setter TargetName="InfoCard1" Property="Grid.Column" Value="0"/>
                        <Setter TargetName="InfoCard1" Property="Grid.Row" Value="0"/>
                        <Setter TargetName="InfoCard2" Property="Grid.Column" Value="1"/>
                        <Setter TargetName="InfoCard2" Property="Grid.Row" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollView>
            <VerticalStackLayout Spacing="20">

                <!-- Header -->
                <StackLayout x:Name="HeaderStack" 
                           Orientation="Horizontal" 
                           HorizontalOptions="FillAndExpand"
                           VerticalOptions="Center">
                    <Label x:Name="DashboardTitle"
                           Text="Dashboard"
                           Style="{StaticResource PageTitle}"/>

                    <Button x:Name="AddButton"
                            Text="+"
                            Style="{StaticResource FloatingActionButton}"/>
                </StackLayout>

                <!-- Statistics Cards -->
                <Grid x:Name="StatsGrid" 
                      ColumnSpacing="15" 
                      RowSpacing="15">

                    <!-- Card 1: Tiere gesamt -->
                    <Frame x:Name="Card1" Style="{StaticResource CardFrame}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="24" Style="{StaticResource LargeNumber}"/>
                            <Label Text="Tiere gesamt" Style="{StaticResource CardLabel}"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Card 2: Futterpläne gesamt -->
                    <Frame x:Name="Card2" Style="{StaticResource CardFrame}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="3" Style="{StaticResource LargeNumber}"/>
                            <Label Text="Futterpläne gesamt" Style="{StaticResource CardLabel}"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Card 3: Fütterungen diese Woche -->
                    <Frame x:Name="Card3" Style="{StaticResource CardFrame}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="12" Style="{StaticResource LargeNumber}"/>
                            <Label Text="Fütterungen diese Woche" Style="{StaticResource CardLabel}"/>
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <!-- Info Cards -->
                <Grid x:Name="InfoGrid" 
                      ColumnSpacing="15" 
                      RowSpacing="15">

                    <!-- Aktiver Futterplan -->
                    <Frame x:Name="InfoCard1" Style="{StaticResource InfoCardFrame}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Aktiver Futterplan" Style="{StaticResource InfoTitle}"/>

                            <HorizontalStackLayout Spacing="5">
                                <Label Text="Plan:" Style="{StaticResource InfoLabel}"/>
                                <Label Text="Sommer-Standard-Plan" Style="{StaticResource InfoValue}"/>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="5">
                                <Label Text="Futter:" Style="{StaticResource InfoLabel}"/>
                                <Label Text="Hühnchen, 2kg pro Tier" Style="{StaticResource InfoValue}"/>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="5">
                                <Label Text="Frequenz:" Style="{StaticResource InfoLabel}"/>
                                <Label Text="2x pro Woche (Mittwoch, Sonntag)" Style="{StaticResource InfoValue}"/>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="5">
                                <Label Text="Gültig seit:" Style="{StaticResource InfoLabel}"/>
                                <Label Text="01.06.2025" Style="{StaticResource InfoValue}"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Letzte Fütterung -->
                    <Frame x:Name="InfoCard2" Style="{StaticResource InfoCardFrame}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Letzte Fütterung" Style="{StaticResource InfoTitle}"/>

                            <HorizontalStackLayout Spacing="5">
                                <Label Text="Datum:" Style="{StaticResource InfoLabel}"/>
                                <Label Text="06.11.2025" Style="{StaticResource InfoValue}"/>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="5">
                                <Label Text="Plan:" Style="{StaticResource InfoLabel}"/>
                                <Label Text="Sommer-Standard-Plan" Style="{StaticResource InfoValue}"/>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="5">
                                <Label Text="Status:" Style="{StaticResource InfoLabel}"/>
                                <Label Text="durchgeführt" 
                                       Style="{StaticResource InfoValueSuccess}"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>