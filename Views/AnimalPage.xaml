<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CrocoManager.Views.AnimalPage">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="10">

            <!-- Content ÜBER der Card -->
            <Label Text="Meine Tiersammlung" FontSize="24" FontAttributes="Bold"/>
            <Label Text="Hier verwaltest du alle deine Tiere" FontSize="14" TextColor="Gray"/>
            <Button Text="Neues Tier hinzufügen" />

            <!-- Die CARD mit dem Grid -->
            <Frame CornerRadius="8" 
                   HasShadow="True" 
                   Padding="0"
                   Margin="0,10">

                <Grid RowDefinitions="Auto,200" ColumnSpacing="0">
                    <!-- Grid Header (fixiert in der Card) -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="0" BackgroundColor="White">
                        <ScrollView Grid.Column="0" 
                                   Orientation="Horizontal" 
                                   x:Name="headerScroll"
                                   Scrolled="OnAnyScrolled"
                                   HorizontalScrollBarVisibility="Never">
                            <Grid ColumnDefinitions="150,150,150,150" 
                                  Padding="10" 
                                  BackgroundColor="#F5F5F5"
                                  ColumnSpacing="10"
                                  HeightRequest="50">
                                <Label Grid.Column="0" Text="Name" FontAttributes="Bold" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="Geschlecht" FontAttributes="Bold" VerticalOptions="Center"/>
                                <Label Grid.Column="2" Text="Alter" FontAttributes="Bold" VerticalOptions="Center"/>
                                <Label Grid.Column="3" Text="Art" FontAttributes="Bold" VerticalOptions="Center"/>
                            </Grid>
                        </ScrollView>

                        <Grid Grid.Column="1" 
                              Padding="10" 
                              BackgroundColor="#F5F5F5"
                              WidthRequest="100"
                              HeightRequest="50">
                            <Label Text="Aktion" FontAttributes="Bold" VerticalOptions="Center"/>
                        </Grid>
                    </Grid>

                    <!-- Grid Content (scrollbar innerhalb der Card) -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="0" BackgroundColor="White">

                        <ScrollView Grid.Column="0" 
                                   Orientation="Both"
                                   x:Name="contentScroll"
                                   Scrolled="OnAnyScrolled"
                                   HorizontalScrollBarVisibility="Default"
                                   VerticalScrollBarVisibility="Default">
                            <VerticalStackLayout x:Name="dataRows" BindableLayout.ItemsSource="{Binding Animals}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout Spacing="0">
                                            <Grid ColumnDefinitions="150,150,150,150" 
                                                  Padding="10" 
                                                  ColumnSpacing="10"
                                                  HeightRequest="60">
                                                <Label Grid.Column="0" Text="{Binding Name}" VerticalOptions="Center"/>
                                                <Label Grid.Column="1" Text="{Binding Gender}" VerticalOptions="Center"/>
                                                <Label Grid.Column="2" Text="{Binding Age}" VerticalOptions="Center"/>
                                                <Label Grid.Column="3" Text="{Binding Species}" VerticalOptions="Center"/>
                                            </Grid>
                                            <BoxView HeightRequest="1" Color="#E0E0E0"/>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </ScrollView>

                        <!-- Fixierte Actions Spalte mit ContentView für Clipping -->
                        <ContentView Grid.Column="1" 
                                    BackgroundColor="White"
                                    WidthRequest="100">
                            <ContentView.Clip>
                                <RectangleGeometry Rect="0,0,100,200"/>
                            </ContentView.Clip>

                            <VerticalStackLayout x:Name="actionsStack" 
                                                BindableLayout.ItemsSource="{Binding Animals}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout Spacing="0">
                                            <Grid Padding="10" 
                                                  WidthRequest="100"
                                                  HeightRequest="60"
                                                  BackgroundColor="White">
                                                <HorizontalStackLayout Spacing="10" 
                                                                     VerticalOptions="Center"
                                                                     HorizontalOptions="Center">
                                                    <Button Text="✏️"
                                                           BackgroundColor="Transparent" 
                                                           WidthRequest="40" 
                                                           HeightRequest="40"/>
                                                    <Button Text="🗑️"
                                                           BackgroundColor="Transparent" 
                                                           WidthRequest="40" 
                                                           HeightRequest="40"/>
                                                </HorizontalStackLayout>
                                            </Grid>
                                            <BoxView HeightRequest="1" Color="#E0E0E0"/>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </ContentView>
                    </Grid>
                </Grid>
            </Frame>

            <!-- Content UNTER der Card -->
            <Label Text="Statistiken" FontSize="20" FontAttributes="Bold" Margin="0,20,0,0"/>
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Frame Grid.Column="0" Grid.Row="0" Padding="15">
                    <VerticalStackLayout>
                        <Label Text="Gesamt Tiere" FontSize="12" TextColor="Gray"/>
                        <Label Text="{Binding Animals.Count}" FontSize="24" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Frame>
                <Frame Grid.Column="1" Grid.Row="0" Padding="15">
                    <VerticalStackLayout>
                        <Label Text="Männlich" FontSize="12" TextColor="Gray"/>
                        <Label Text="3" FontSize="24" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>