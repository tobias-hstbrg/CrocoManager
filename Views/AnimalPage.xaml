<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:viewmodels="clr-namespace:CrocoManager.ViewModel"
    xmlns:models="clr-namespace:CrocoManager.Models"
             x:Class="CrocoManager.Views.AnimalPage"
             Title="">
    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">
            <!-- Header Section -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="15">
                <Label Grid.Column="0" 
                       Text="Tiere verwalten" 
                       FontSize="28" 
                       FontAttributes="Bold"
                       VerticalOptions="Center"/>
                <Button Grid.Column="1" 
                        Text="➕ Neues Tier"
                        Command="{Binding AddNewAnimalCommand}"
                        BackgroundColor="#00BFA5"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        Padding="20,10"/>
            </Grid>
            <!-- Animals Grid Card -->
            <Frame CornerRadius="12" 
                   HasShadow="True" 
                   Padding="0"
                   Margin="0,10">
                <Grid RowDefinitions="Auto,300" ColumnSpacing="0">
                    <!-- Grid Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="0" BackgroundColor="White">
                        <ScrollView Grid.Column="0" 
                                   Orientation="Horizontal" 
                                   x:Name="headerScroll"
                                   Scrolled="OnAnyScrolled"
                                   HorizontalScrollBarVisibility="Never">
                            <Grid ColumnDefinitions="150,150,100,200" 
                                  Padding="15" 
                                  BackgroundColor="#F8F9FA"
                                  ColumnSpacing="15"
                                  HeightRequest="50">
                                <Label Grid.Column="0" Text="Name" FontAttributes="Bold" VerticalOptions="Center" FontSize="14"/>
                                <Label Grid.Column="1" Text="Geschlecht" FontAttributes="Bold" VerticalOptions="Center" FontSize="14"/>
                                <Label Grid.Column="2" Text="Alter" FontAttributes="Bold" VerticalOptions="Center" FontSize="14"/>
                                <Label Grid.Column="3" Text="Art" FontAttributes="Bold" VerticalOptions="Center" FontSize="14"/>
                            </Grid>
                        </ScrollView>
                        <Grid Grid.Column="1" 
                              Padding="15" 
                              BackgroundColor="#F8F9FA"
                              WidthRequest="120"
                              HeightRequest="50">
                            <Label Text="Aktion" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center" FontSize="14"/>
                        </Grid>
                    </Grid>
                    <!-- Grid Content -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="0" BackgroundColor="White">
                        <ScrollView Grid.Column="0" 
                                   Orientation="Both"
                                   x:Name="contentScroll"
                                   Scrolled="OnAnyScrolled"
                                   HorizontalScrollBarVisibility="Default"
                                   VerticalScrollBarVisibility="Default">
                            <VerticalStackLayout x:Name="dataRows" BindableLayout.ItemsSource="{Binding Animals}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:Animal">
                                        <VerticalStackLayout Spacing="0">
                                            <Grid ColumnDefinitions="150,150,100,200" 
                                                  Padding="15" 
                                                  ColumnSpacing="15"
                                                  HeightRequest="60">
                                                <Label Grid.Column="0" Text="{Binding Name}" VerticalOptions="Center" FontSize="14"/>
                                                <Label Grid.Column="1" Text="{Binding Gender}" VerticalOptions="Center" FontSize="14"/>
                                                <Label Grid.Column="2" Text="{Binding Age}" VerticalOptions="Center" FontSize="14"/>
                                                <Label Grid.Column="3" Text="{Binding Species}" VerticalOptions="Center" FontSize="14" LineBreakMode="TailTruncation"/>
                                            </Grid>
                                            <BoxView HeightRequest="1" Color="#E9ECEF"/>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </ScrollView>
                        <!-- Fixed Actions Column -->
                        <ContentView Grid.Column="1"
             BackgroundColor="White"
             WidthRequest="120">

                            <ContentView.Clip>
                                <RectangleGeometry Rect="0,0,120,300"/>
                            </ContentView.Clip>

                            <VerticalStackLayout x:Name="actionsStack" BindableLayout.ItemsSource="{Binding Animals}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:Animal">
                                        <VerticalStackLayout Spacing="0">

                                            <Grid Padding="15"
                          WidthRequest="120"
                          HeightRequest="60"
                          BackgroundColor="White">

                                                <HorizontalStackLayout Spacing="10"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center">

                                                    <ImageButton Source="pencil.png"
                                         BackgroundColor="Transparent"
                                         WidthRequest="24"
                                         HeightRequest="24"
                                         Command="{Binding BindingContext.EditAnimalCommand,
                                                   Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                         CommandParameter="{Binding .}" />

                                                    <ImageButton Source="trash.png"
                                         BackgroundColor="Transparent"
                                         WidthRequest="24"
                                         HeightRequest="24"
                                         Command="{Binding BindingContext.DeleteAnimalCommand,
                                                   Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                         CommandParameter="{Binding .}" />

                                                </HorizontalStackLayout>
                                            </Grid>

                                            <BoxView HeightRequest="1" Color="#E9ECEF"/>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                        </ContentView>
                    </Grid>
                </Grid>
            </Frame>
            <!-- Animal Form Card -->
            <Frame CornerRadius="12" HasShadow="True" Padding="20" BackgroundColor="White">
                <VerticalStackLayout Spacing="20">
                    <Label Text="{Binding PageTitle}" 
                           FontSize="22" 
                           FontAttributes="Bold"/>
                    <!-- Name -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Name *" FontSize="14" TextColor="#6C757D"/>
                        <Entry Text="{Binding Name}" 
                               Placeholder="z.B. Charlie"
                               FontSize="16"/>
                    </VerticalStackLayout>
                    <!-- Geschlecht -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Geschlecht *" FontSize="14" TextColor="#6C757D"/>
                        <Picker ItemsSource="{Binding GenderOptions}"
                                SelectedItem="{Binding Gender}"
                                FontSize="16"/>
                    </VerticalStackLayout>
                    <!-- Alter -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Alter" FontSize="14" TextColor="#6C757D"/>
                        <Entry Text="{Binding Age}" 
                               Placeholder="z.B. 8"
                               Keyboard="Numeric"
                               FontSize="16"/>
                    </VerticalStackLayout>
                    <!-- Art -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Art *" FontSize="14" TextColor="#6C757D"/>
                        <Picker ItemsSource="{Binding SpeciesOptions}"
                                SelectedItem="{Binding Species}"
                                FontSize="16"/>
                    </VerticalStackLayout>
                    <!-- Gehege -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Gehege" FontSize="14" TextColor="#6C757D"/>
                        <Entry Text="{Binding Enclosure}" 
                               Placeholder="z.B. Gehege A"
                               FontSize="16"/>
                    </VerticalStackLayout>
                    <!-- Beschreibung -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Beschreibung / Besonderheiten" FontSize="14" TextColor="#6C757D"/>
                        <Editor Text="{Binding Description}" 
                                Placeholder="Optionale Notizen zum Tier..."
                                HeightRequest="100"
                                FontSize="16"/>
                    </VerticalStackLayout>
                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                        <Button Grid.Column="0"
                                Text="Abbrechen"
                                Command="{Binding CancelCommand}"
                                BackgroundColor="#6C757D"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                HeightRequest="45"/>
                        <Button Grid.Column="1"
                                Text="Speichern"
                                Command="{Binding SaveAnimalCommand}"
                                BackgroundColor="#00BFA5"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                HeightRequest="45"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>