<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:viewmodels="clr-namespace:CrocoManager.ViewModel"
	xmlns:models="clr-namespace:CrocoManager.Models"
             x:Class="CrocoManager.Views.AnimalPage"
             Title=""
             BackgroundColor="{StaticResource PageBackground}">
    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">
            <!-- Header Section -->
            <Grid ColumnDefinitions="*,Auto, Auto" ColumnSpacing="15">
                <Label Grid.Column="0" 
                       Text="Tiere verwalten" 
                       FontSize="28" 
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"
                       VerticalOptions="Center"/>
                <Button Grid.Column="1" 
                        Text="➕ Neues Tier"
                        Command="{Binding AddNewAnimalCommand}"
                        Style="{StaticResource PrimaryButton}"
                        CornerRadius="8"
                        Padding="20,10"/>
                <Button Grid.Column="2"
                        Text="🚪"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource TextOnPrimary}"
                        BorderColor="Transparent"
                        WidthRequest="50"
                        HeightRequest="50"
                        CornerRadius="8"
                        FontSize="16"
                        Padding="10"
                        VerticalOptions="Center"
                        Command="{Binding SignOutCommand}"/>
            </Grid>
            <!-- Animals Grid Card -->
            <Border Style="{StaticResource SecondaryCard}"
        Padding="0"
        Margin="0,10">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>

                <Grid RowDefinitions="Auto,300"
          ColumnSpacing="0">

                    <!-- ================= HEADER ================= -->
                    <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              BackgroundColor="Transparent">

                        <!-- Scrollbarer Header -->
                        <ScrollView x:Name="headerScroll"
                        Grid.Column="0"
                        Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never"
                        Scrolled="OnAnyScrolled">

                            <Grid ColumnDefinitions="150,150,100,150,200"
                      Padding="15"
                      HeightRequest="50"
                      ColumnSpacing="15"
                      BackgroundColor="{StaticResource CardBackground}">

                                <Label Grid.Column="0" Text="Name" FontAttributes="Bold"/>
                                <Label Grid.Column="1" Text="Geschlecht" FontAttributes="Bold"/>
                                <Label Grid.Column="2" Text="Alter" FontAttributes="Bold"/>
                                <Label Grid.Column="3" Text="Gehege" FontAttributes="Bold"/>
                                <Label Grid.Column="4" Text="Art" FontAttributes="Bold"/>
                            </Grid>
                        </ScrollView>

                        <!-- Action Header -->
                        <Grid Grid.Column="1"
                  WidthRequest="120"
                  HeightRequest="50"
                  Padding="15"
                  BackgroundColor="{StaticResource CardBackground}">
                            <Label Text="Aktion"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
                        </Grid>
                    </Grid>

                    <!-- ================= CONTENT ================= -->
                    <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto">

                        <!-- Scrollbarer Content -->
                        <ScrollView x:Name="contentScroll"
                        Grid.Column="0"
                        Orientation="Both"
                        Scrolled="OnAnyScrolled">

                            <VerticalStackLayout x:Name="dataRows"
                                     BindableLayout.ItemsSource="{Binding Animals}">

                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:Animal">
                                        <VerticalStackLayout Spacing="0">

                                            <Grid ColumnDefinitions="150,150,100,150,200"
                                      Padding="15"
                                      HeightRequest="60"
                                      ColumnSpacing="15"
                                      BackgroundColor="{StaticResource CardBackground}">

                                                <Label Grid.Column="0" Text="{Binding Name}"/>
                                                <Label Grid.Column="1" Text="{Binding Gender}"/>
                                                <Label Grid.Column="2" Text="{Binding Age}"/>
                                                <Label Grid.Column="3" Text="{Binding Enclosure}"/>
                                                <Label Grid.Column="4" Text="{Binding Species}"
                                           LineBreakMode="TailTruncation"/>
                                            </Grid>

                                            <BoxView HeightRequest="1"
                                         Color="{StaticResource BorderColor}"/>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>

                            </VerticalStackLayout>
                        </ScrollView>

                        <!-- ================= ACTIONS (FROZEN) ================= -->
                        <ScrollView x:Name="actionsScroll"
                        Grid.Column="1"
                        Orientation="Vertical"
                        VerticalScrollBarVisibility="Never"
                        Scrolled="OnAnyScrolled"
                        WidthRequest="120"
                        BackgroundColor="{StaticResource CardBackground}">

                            <VerticalStackLayout x:Name="actionsStack"
                                     BindableLayout.ItemsSource="{Binding Animals}">

                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:Animal">
                                        <VerticalStackLayout Spacing="0">

                                            <Grid Padding="15"
                                      HeightRequest="60"
                                      WidthRequest="120"
                                      BackgroundColor="{StaticResource CardBackground}">

                                                <HorizontalStackLayout Spacing="10"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center">

                                                    <ImageButton Source="edit.png"
                                                     BackgroundColor="Transparent"
                                                     Command="{Binding BindingContext.EditAnimalCommand,
                                                       Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                     CommandParameter="{Binding .}"/>

                                                    <ImageButton Source="trash.png"
                                                     BackgroundColor="Transparent"
                                                     Command="{Binding BindingContext.DeleteAnimalCommand,
                                                       Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                     CommandParameter="{Binding .}"/>

                                                </HorizontalStackLayout>
                                            </Grid>

                                            <BoxView HeightRequest="1"
                                         Color="{StaticResource BorderColor}"/>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>

                            </VerticalStackLayout>
                        </ScrollView>

                    </Grid>
                </Grid>
            </Border>
            <!-- Animal Form Card -->
            <Border
                    Style="{StaticResource SecondaryCard}" 
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="20">
                    <Label Text="{Binding PageTitle}" 
                           FontSize="22" 
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"/>
                    <!-- Name -->
                    <VerticalStackLayout Spacing="5">
                        <Label FontSize="14" TextColor="{StaticResource TextSecondary}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Name "/>
                                    <Span Text="*" TextColor="Red"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Border Style="{StaticResource EntryBorder}"
                                Padding="12,0"
                                HeightRequest="48">
                            <Entry Text="{Binding Name}" 
                                   Placeholder="z.B. Charlie"
                                   FontSize="16"
                                   TextColor="{StaticResource TextPrimary}"
                                   PlaceholderColor="{StaticResource PlaceholderText}"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>
                    <!-- Geschlecht -->
                    <VerticalStackLayout Spacing="5">
                        <Label FontSize="14" TextColor="{StaticResource TextSecondary}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Geschlecht "/>
                                    <Span Text="*" TextColor="Red"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Border Style="{StaticResource EntryBorder}"
                                Padding="12,0"
                                HeightRequest="48">
                            <Picker ItemsSource="{Binding GenderOptions}"
                                    SelectedItem="{Binding Gender}"
                                    FontSize="16"
                                    TextColor="{StaticResource TextPrimary}"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>
                    <!-- Alter -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Alter" FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                        <Border Style="{StaticResource EntryBorder}"
                                Padding="12,0"
                                HeightRequest="48">
                            <Entry Text="{Binding Age}" 
                                   Placeholder="z.B. 8"
                                   Keyboard="Numeric"
                                   FontSize="16"
                                   TextColor="{StaticResource TextPrimary}"
                                   PlaceholderColor="{StaticResource PlaceholderText}"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>
                    <!-- Art -->
                    <VerticalStackLayout Spacing="5">
                        <Label FontSize="14" TextColor="{StaticResource TextSecondary}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Art "/>
                                    <Span Text="*" TextColor="Red"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Border Style="{StaticResource EntryBorder}"
                                Padding="12,0"
                                HeightRequest="48">
                            <Picker ItemsSource="{Binding SpeciesOptions}"
                                    SelectedItem="{Binding Species}"
                                    FontSize="16"
                                    TextColor="{StaticResource TextPrimary}"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>
                    <!-- Gehege -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Gehege" FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                        <Border Style="{StaticResource EntryBorder}"
                                Padding="12,0"
                                HeightRequest="48">
                            <Entry Text="{Binding Enclosure}" 
                                   Placeholder="z.B. Gehege A"
                                   FontSize="16"
                                   TextColor="{StaticResource TextPrimary}"
                                   PlaceholderColor="{StaticResource PlaceholderText}"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>
                    <!-- Beschreibung -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Beschreibung / Besonderheiten" FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                        <Border Style="{StaticResource EntryBorder}"
                                Padding="12"
                                HeightRequest="100">
                            <Editor Text="{Binding Description}" 
                                    Placeholder="Optionale Notizen zum Tier..."
                                    FontSize="16"
                                    TextColor="{StaticResource TextPrimary}"
                                    PlaceholderColor="{StaticResource PlaceholderText}"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Fill"/>
                        </Border>
                    </VerticalStackLayout>
                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                        <Button Grid.Column="0"
                                Text="Abbrechen"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource SecondaryButton}"
                                HeightRequest="45"/>
                        <Button Grid.Column="1"
                                Text="Speichern"
                                Command="{Binding SaveAnimalCommand}"
                                Style="{StaticResource PrimaryButton}"
                                HeightRequest="45"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>