<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:viewmodels="clr-namespace:CrocoManager.ViewModel"
	xmlns:models="clr-namespace:CrocoManager.Models"
             x:Class="CrocoManager.Views.AnimalPage"
             Title=""
             BackgroundColor="{StaticResource PageBackground}">
    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">
            <!-- Header Section -->
            <Grid ColumnDefinitions="*,Auto, Auto" ColumnSpacing="15">
                <Label Grid.Column="0" 
                       Text="Tiere verwalten" 
                       FontSize="28" 
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"
                       VerticalOptions="Center"/>
                <Button Grid.Column="1" 
                        Text="➕ Neues Tier"
                        Command="{Binding AddNewAnimalCommand}"
                        Style="{StaticResource PrimaryButton}"
                        CornerRadius="8"
                        Padding="20,10"/>
                <Button Grid.Column="2"
                        Text="🚪"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource TextOnPrimary}"
                        BorderColor="Transparent"
                        WidthRequest="50"
                        HeightRequest="50"
                        CornerRadius="8"
                        FontSize="16"
                        Padding="10"
                        VerticalOptions="Center"
                        Command="{Binding SignOutCommand}"/>
            </Grid>
            <!-- Animals Grid Card -->
            <Border 
                    Style="{StaticResource SecondaryCard}"
                    Padding="0"
                    Margin="0,10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Grid RowDefinitions="Auto,300" ColumnSpacing="0">
                    <!-- Grid Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="0" BackgroundColor="Transparent">
                        <ScrollView Grid.Column="0" 
                                   Orientation="Horizontal" 
                                   x:Name="headerScroll"
                                   Scrolled="OnAnyScrolled"
                                   HorizontalScrollBarVisibility="Never">
                            <Grid ColumnDefinitions="150,150,100,150,200" 
                                  Padding="15" 
                                  BackgroundColor="{StaticResource CardBackground}"
                                  ColumnSpacing="15"
                                  HeightRequest="50">
                                <Label Grid.Column="0" Text="Name" FontAttributes="Bold" VerticalOptions="Center" FontSize="14" TextColor="{StaticResource TextPrimary}"/>
                                <Label Grid.Column="1" Text="Geschlecht" FontAttributes="Bold" VerticalOptions="Center" FontSize="14" TextColor="{StaticResource TextPrimary}"/>
                                <Label Grid.Column="2" Text="Alter" FontAttributes="Bold" VerticalOptions="Center" FontSize="14" TextColor="{StaticResource TextPrimary}"/>
                                <Label Grid.Column="3" Text="Gehege" FontAttributes="Bold" VerticalOptions="Center" FontSize="14" TextColor="{StaticResource TextPrimary}"/>
                                <Label Grid.Column="4" Text="Art" FontAttributes="Bold" VerticalOptions="Center" FontSize="14" TextColor="{StaticResource TextPrimary}"/>
                            </Grid>
                        </ScrollView>
                        <Grid Grid.Column="1" 
                              Padding="15" 
                              BackgroundColor="{StaticResource CardBackground}"
                              WidthRequest="120"
                              HeightRequest="50">
                            <Label Text="Aktion" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center" FontSize="14" TextColor="{StaticResource TextPrimary}"/>
                        </Grid>
                    </Grid>
                    <!-- Grid Content -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="0" BackgroundColor="Transparent">
                        <!-- Scrollable Content mit Overlay-Gradient -->
                        <Grid Grid.Column="0">
                            <ScrollView Orientation="Both"
                   x:Name="contentScroll"
                   Scrolled="OnAnyScrolled"
                   HorizontalScrollBarVisibility="Default"
                   VerticalScrollBarVisibility="Default">
                                <VerticalStackLayout x:Name="dataRows" BindableLayout.ItemsSource="{Binding Animals}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:Animal">
                                            <VerticalStackLayout Spacing="0">
                                                <Grid ColumnDefinitions="150,150,100,150,200" 
                                  Padding="15" 
                                  ColumnSpacing="15"
                                  HeightRequest="60"
                                  BackgroundColor="{StaticResource CardBackground}">
                                                    <Label Grid.Column="0" Text="{Binding Name}" VerticalOptions="Center" FontSize="14" TextColor="{StaticResource TextPrimary}"/>
                                                    <Label Grid.Column="1" Text="{Binding Gender}" VerticalOptions="Center" FontSize="14" TextColor="{StaticResource TextPrimary}"/>
                                                    <Label Grid.Column="2" Text="{Binding Age}" VerticalOptions="Center" FontSize="14" TextColor="{StaticResource TextPrimary}"/>
                                                    <Label Grid.Column="3" Text="{Binding Enclosure}" VerticalOptions="Center" FontSize="14" TextColor="{StaticResource TextPrimary}"/>
                                                    <Label Grid.Column="4" Text="{Binding Species}" VerticalOptions="Center" FontSize="14" LineBreakMode="TailTruncation" TextColor="{StaticResource TextPrimary}"/>
                                                </Grid>
                                                <BoxView HeightRequest="1" Color="{StaticResource BorderColor}"/>
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </ScrollView>
                            <Grid HorizontalOptions="End"
              WidthRequest="32"
              InputTransparent="True">
                                <!-- Thin Vertical Line -->
                                <BoxView HorizontalOptions="End"
                     WidthRequest="1"
                     Color="{StaticResource BorderColor}"
                     Opacity="0.5"/>
                            </Grid>
                        </Grid>
                        <!-- Fixed Actions Column -->
                        <ContentView Grid.Column="1"
                 BackgroundColor="{StaticResource CardBackground}"
                 WidthRequest="120">
                            <ContentView.Clip>
                                <RectangleGeometry Rect="0,0,120,300"/>
                            </ContentView.Clip>
                            <VerticalStackLayout x:Name="actionsStack" BindableLayout.ItemsSource="{Binding Animals}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:Animal">
                                        <VerticalStackLayout Spacing="0">
                                            <Grid Padding="15"
                              WidthRequest="120"
                              HeightRequest="60"
                              BackgroundColor="{StaticResource CardBackground}">
                                                <HorizontalStackLayout Spacing="10"
                               VerticalOptions="Center"
                               HorizontalOptions="Center">
                                                    <!-- Edit Button -->
                                                    <Border BackgroundColor="Transparent"
                                 StrokeThickness="0">
                                                        <Border.WidthRequest>
                                                            <OnIdiom x:TypeArguments="x:Double" Phone="28" Desktop="40"/>
                                                        </Border.WidthRequest>
                                                        <Border.HeightRequest>
                                                            <OnIdiom x:TypeArguments="x:Double" Phone="28" Desktop="40"/>
                                                        </Border.HeightRequest>
                                                        <ImageButton Source="edit.png"
                                     BackgroundColor="Transparent"
                                     Aspect="AspectFit"
                                     Command="{Binding BindingContext.EditAnimalCommand,
                                               Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                     CommandParameter="{Binding .}"/>
                                                    </Border>
                                                    <!-- Delete Button -->
                                                    <Border BackgroundColor="Transparent"
                                StrokeThickness="0">
                                                        <Border.WidthRequest>
                                                            <OnIdiom x:TypeArguments="x:Double" Phone="28" Desktop="45"/>
                                                        </Border.WidthRequest>
                                                        <Border.HeightRequest>
                                                            <OnIdiom x:TypeArguments="x:Double" Phone="28" Desktop="45"/>
                                                        </Border.HeightRequest>
                                                        <ImageButton Source="trash.png"
                                     BackgroundColor="Transparent"
                                     Aspect="AspectFit"
                                     Command="{Binding BindingContext.DeleteAnimalCommand,
                                               Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                     CommandParameter="{Binding .}"/>
                                                    </Border>
                                                </HorizontalStackLayout>
                                            </Grid>
                                            <BoxView HeightRequest="1" Color="{StaticResource BorderColor}"/>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </ContentView>
                    </Grid>
                </Grid>
            </Border>
            <!-- Animal Form Card -->
            <Border
                    Style="{StaticResource SecondaryCard}" 
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="20">
                    <Label Text="{Binding PageTitle}" 
                           FontSize="22" 
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"/>
                    <!-- Name -->
                    <VerticalStackLayout Spacing="5">
                        <Label FontSize="14" TextColor="{StaticResource TextSecondary}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Name "/>
                                    <Span Text="*" TextColor="Red"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Border Style="{StaticResource EntryBorder}"
                                Padding="12,0"
                                HeightRequest="48">
                            <Entry Text="{Binding Name}" 
                                   Placeholder="z.B. Charlie"
                                   FontSize="16"
                                   TextColor="{StaticResource TextPrimary}"
                                   PlaceholderColor="{StaticResource PlaceholderText}"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>
                    <!-- Geschlecht -->
                    <VerticalStackLayout Spacing="5">
                        <Label FontSize="14" TextColor="{StaticResource TextSecondary}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Geschlecht "/>
                                    <Span Text="*" TextColor="Red"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Border Style="{StaticResource EntryBorder}"
                                Padding="12,0"
                                HeightRequest="48">
                            <Picker ItemsSource="{Binding GenderOptions}"
                                    SelectedItem="{Binding Gender}"
                                    FontSize="16"
                                    TextColor="{StaticResource TextPrimary}"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>
                    <!-- Alter -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Alter" FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                        <Border Style="{StaticResource EntryBorder}"
                                Padding="12,0"
                                HeightRequest="48">
                            <Entry Text="{Binding Age}" 
                                   Placeholder="z.B. 8"
                                   Keyboard="Numeric"
                                   FontSize="16"
                                   TextColor="{StaticResource TextPrimary}"
                                   PlaceholderColor="{StaticResource PlaceholderText}"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>
                    <!-- Art -->
                    <VerticalStackLayout Spacing="5">
                        <Label FontSize="14" TextColor="{StaticResource TextSecondary}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Art "/>
                                    <Span Text="*" TextColor="Red"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Border Style="{StaticResource EntryBorder}"
                                Padding="12,0"
                                HeightRequest="48">
                            <Picker ItemsSource="{Binding SpeciesOptions}"
                                    SelectedItem="{Binding Species}"
                                    FontSize="16"
                                    TextColor="{StaticResource TextPrimary}"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>
                    <!-- Gehege -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Gehege" FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                        <Border Style="{StaticResource EntryBorder}"
                                Padding="12,0"
                                HeightRequest="48">
                            <Entry Text="{Binding Enclosure}" 
                                   Placeholder="z.B. Gehege A"
                                   FontSize="16"
                                   TextColor="{StaticResource TextPrimary}"
                                   PlaceholderColor="{StaticResource PlaceholderText}"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>
                    <!-- Beschreibung -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Beschreibung / Besonderheiten" FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                        <Border Style="{StaticResource EntryBorder}"
                                Padding="12"
                                HeightRequest="100">
                            <Editor Text="{Binding Description}" 
                                    Placeholder="Optionale Notizen zum Tier..."
                                    FontSize="16"
                                    TextColor="{StaticResource TextPrimary}"
                                    PlaceholderColor="{StaticResource PlaceholderText}"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Fill"/>
                        </Border>
                    </VerticalStackLayout>
                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                        <Button Grid.Column="0"
                                Text="Abbrechen"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource SecondaryButton}"
                                HeightRequest="45"/>
                        <Button Grid.Column="1"
                                Text="Speichern"
                                Command="{Binding SaveAnimalCommand}"
                                Style="{StaticResource PrimaryButton}"
                                HeightRequest="45"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>